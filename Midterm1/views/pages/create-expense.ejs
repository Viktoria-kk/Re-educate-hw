<%- include('../partials/header.ejs') %>
<section class="form-card">
  <span class="eyebrow">Create expense</span>
  <h1>Add an expense</h1>
  <p>Enter the category and amount below.</p>
  <% if (error) { %>
  <p class="error"><%= error %></p>
  <% } %>
  <form action="/api/expenses" method="POST">
    <label for="category">Category</label
    ><input
      id="category"
      name="category"
      value="<%= expense.category || '' %>"
      placeholder="e.g. Beauty"
      required
    /><label for="price">Price</label
    ><input
      id="price"
      name="price"
      type="number"
      min="0"
      step="0.01"
      value="<%= expense.price || '' %>"
      placeholder="0.00"
      required
    />
    <div class="form-actions">
      <button type="submit">Save expense</button><a href="/">Cancel</a>
    </div>
  </form>
</section>
<%- include('../partials/footer.ejs') %>
