<%- include('../partials/header.ejs') %>
<section class="form-card">
  <span class="eyebrow">Update expense</span>
  <h1>Edit expense</h1>
  <p>Update the category or amount below.</p>
  <% if (error) { %>
  <p class="error"><%= error %></p>
  <% } %>
  <form action="/api/expenses/<%= expense.id %>/update" method="POST">
    <label for="category">Category</label
    ><input
      id="category"
      name="category"
      value="<%= expense.category %>"
      required
    /><label for="price">Price</label
    ><input
      id="price"
      name="price"
      type="number"
      min="0"
      step="0.01"
      value="<%= expense.price %>"
      required
    />
    <div class="form-actions">
      <button type="submit">Update expense</button
      ><a href="/expenses/<%= expense.id %>">Cancel</a>
    </div>
  </form>
</section>
<%- include('../partials/footer.ejs') %>
